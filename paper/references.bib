@article{park2026,
title = {Hybrid multi-stage framework for identifying zero-day attacks and known threats in network traffic},
journal = {Computer Networks},
volume = {275},
pages = {111875},
year = {2026},
issn = {1389-1286},
doi = {10.1016/j.comnet.2025.111875},
author = {Yeon-Seo Park and Yeon-Sup Lim},
keywords = {Network traffic classification, Network anomaly detection, Intrusion detection system, Zero-day network attacks, Machine learning},
abstract = {The rapid advance of network technologies and the proliferation of diverse network applications have led to the continuous emergence of zero-day attacks-novel, previously unseen cyber threats. Detecting such attacks remains a fundamental challenge for intrusion detection systems (IDS), as they deviate from known patterns and cannot be captured effectively by traditional signature-based or purely supervised approaches. To tackle this challenge, we propose a multi-stage detection framework that integrates unsupervised and supervised machine learning approaches, such as clustering, a variational autoencoder (VAE), and a deep neural network (DNN), to identify both zero-day and known attacks. The process begins with a benign traffic filter based on radius-aware K-means clustering, which employs a robust statistical threshold to define cluster boundaries. The remaining traffic is then analyzed by a VAE that leverages Mahalanobis distance in the latent space, relative to benign traffic, to detect zero-day threats as anomalies. Finally, a supervised DNN classifies the remaining traffic into known attack categories. Our evaluation using the CICIDS2017 and CICIDS2018 datasets demonstrates that the proposed framework achieves strong generalization to unseen attacks, low false positive rates, and robustness under realistic network conditions. These results highlight the effectiveness of combining unsupervised and supervised learning for zero-day attack detection.}
}

